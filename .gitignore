# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive tfvars files (keep example files committed)
*.tfvars
!*.tfvars.example

# Ignore override files as they are usually used for local developer setup
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI config files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan
*.plan

# macOS / OS artifacts
.DS_Store
Thumbs.db
